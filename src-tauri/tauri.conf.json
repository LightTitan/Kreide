{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kreide", "version": "0.2.0", "identifier": "com.kreide.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "Kreide", "width": 1236, "height": 852, "minWidth": 480, "minHeight": 420, "center": true, "titleBarStyle": "Overlay", "hiddenTitle": true, "trafficLightPosition": { "x": 16, "y": 22 } }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'", "capabilities": ["main"] }
  },
  "bundle": { "active": true, "targets": ["app"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"], "macOS": { "minimumSystemVersion": "14.0", "signingIdentity": "-" }, "shortDescription": "Temporary AI chats, one keystroke away." }
}
